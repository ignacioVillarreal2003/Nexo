SPRING_PROFILES_ACTIVE=dev

POSTGRES_HOST=nexo-postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo

AUTHENTICATION_DB=nexo_authentication
NOTIFICATION_DB=nexo_notification
TOPIC_DB=nexo_topic
SUBSCRIPTION_DB=nexo_subscription
CONTENT_DB=nexo_content
DELIVERY_DB=nexo_delivery

REDIS_HOST=nexo-redis
REDIS_PORT=6379
REDIS_SSL=false

KAFKA_BOOTSTRAP_SERVERS=nexo-kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_REPLICAS=1

# Correo saliente por SMTP real (Gmail). MAIL_USERNAME y EMAIL_FROM: la cuenta de Gmail que envía.
# MAIL_PASSWORD: una contraseña de aplicación de esa cuenta (https://myaccount.google.com/apppasswords),
# 16 letras sin espacios. Sin usuario y contraseña válidos los correos quedan en reintento y no salen.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
EMAIL_ENABLED=true
MAIL_USERNAME=
MAIL_PASSWORD=
# Si EMAIL_FROM queda vacío se usa MAIL_USERNAME (Gmail exige que coincidan).
EMAIL_FROM=

NOTIFICATION_COMMANDS_TOPIC=nexo.notifications.commands
NOTIFICATION_COMMANDS_CONCURRENCY=3
USER_EVENTS_TOPIC=nexo.authentication.user-events
USER_EVENTS_DEAD_LETTER_TOPIC=nexo.authentication.user-events.dlt
USER_EVENTS_PARTITIONS=3
USER_EVENTS_CONCURRENCY=2
USER_EVENTS_ENABLED=true
NOTIFICATIONS_ENABLED=true
CONTENT_COLLECTED_TOPIC=nexo.content.collected

# Administrador inicial (se crea al arrancar authentication).
ADMIN_EMAIL=admin@nexo.local
ADMIN_PASSWORD=Admin123!

# Clientes de servicio (client_credentials). Los valores por defecto son los del seed de desarrollo;
# en producción se crean desde Admin > Clientes de servicio y se cargan aquí.
COLLECTOR_SERVICE_CLIENT_ID=c0000000-0000-0000-0000-000000000001
COLLECTOR_SERVICE_CLIENT_SECRET=nexo-collector-dev-secret
CONTENT_SERVICE_CLIENT_ID=c0000000-0000-0000-0000-000000000002
CONTENT_SERVICE_CLIENT_SECRET=nexo-content-dev-secret
DELIVERY_SERVICE_CLIENT_ID=c0000000-0000-0000-0000-000000000003
DELIVERY_SERVICE_CLIENT_SECRET=nexo-delivery-dev-secret

# IA: clave gratuita en https://aistudio.google.com. Vacía = modo heurístico (sin LLM).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_REQUESTS_PER_MINUTE=10
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SUMMARY_LANGUAGE=es

# Recopilación diaria (cron UTC) y fuente opcional NewsAPI.
COLLECT_CRON="0 3 * * *"
NEWSAPI_KEY=

# Antirrepetición.
SEMANTIC_DUPLICATE_THRESHOLD=0.92
SEMANTIC_RELATED_THRESHOLD=0.80
USER_SIMILARITY_THRESHOLD=0.88
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

FRONTEND_BASE_URL=http://localhost:4300
CORS_ALLOWED_ORIGINS=http://localhost:4300
JWT_ISSUER=nexo-authentication
JWT_JSON_WEB_KEY_SET_URI=http://nexo-authentication-api:8090/.well-known/json-web-key-set.json

# true solo si levantaste docker-compose.observability.yml (Tempo)
TRACING_ENABLED=false
OTLP_ENDPOINT=http://nexo-tempo:4318/v1/traces
OTLP_TRACING_ENDPOINT=http://nexo-tempo:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1

MONITORING_USERNAME=prometheus
MONITORING_PASSWORD=prometheus
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Inicio de sesión con Google: ID de cliente de OAuth (tipo "Aplicación web", origen http://localhost:4300).
GOOGLE_CLIENT_ID=
